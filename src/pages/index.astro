---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Hero from "../sections/Hero.astro";
import Catalog from "../components/Catalog.vue";
import CategoryBar from "../components/CategoryBar.vue";
import EmptyState from "../components/EmptyState.astro";
---

<Layout
	title="MX TRIP - Catálogo Turístico"
	description="Rutas, recomendaciones, precios estimados y mapas de orientación para viajeros."
	keywords="MX TRIP, catálogo turístico, viajes, destinos, rutas, México"
>
	<Nav />
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full grow py-8 flex flex-col gap-8">
		<Hero />
    <CategoryBar client:load />
		<Catalog client:load>
			<EmptyState slot="empty" />
		</Catalog>
	</main>
	<Footer />
</Layout>
